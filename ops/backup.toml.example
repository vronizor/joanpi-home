# /etc/joanpi/backup.toml — what joanpi-backup sends to Proton Drive.
# The Proton CLI, its version pin and the backup user are in /etc/joanpi/proton.env.
# Paths may start with ~/ (OWNER_HOME) and use globs. A path that matches nothing fails the run.
# SQLite databases are snapshotted with SQLite's backup API, never copied while live.
# Always skipped: *.log, *-wal, *-shm, *-journal, *.tmp, *.part
#
# kind = "files" (default): the paths, one dated .tar.gz per run, skipped when unchanged.
# kind = "postgres": pg_dump of a Compose service (compose_dir, service), one .tar.gz per run.
# kind = "mirror": one folder copied file by file; only new or changed files go up, and
#   nothing is deleted on the Drive. For large folders that only grow, like photos.

remote = "/my-files/Backups/joanpi"
keep_daily = 14
keep_weekly = 8

[[source]]
name = "babybuddy"
paths = ["~/docker/babybuddy/data"]

[[source]]
name = "kiosk"
paths = ["~/inkbook-digest/data"]

[[source]]
name = "double-feature"
paths = ["~/double-feature/data"]

[[source]]
name = "config"
paths = [
  "~/*/.env",
  "~/docker/*/docker-compose.yml",
  "~/docker/adguard/conf",
  "/etc/joanpi",
]

