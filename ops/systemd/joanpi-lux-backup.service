[Unit]
Description=Lux Archive backup to its data repo
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@OWNER@
ExecStart=/bin/bash @HOME@/lux-archive/scripts/backup.sh
ExecStopPost=+/usr/bin/python3 /usr/local/lib/joanpi/job_status.py joanpi-lux-backup
TimeoutStartSec=30min
Nice=10
