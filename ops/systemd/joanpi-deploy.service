[Unit]
Description=Deploy new release tags of the apps
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@OWNER@
EnvironmentFile=/etc/joanpi/ops.env
ExecStart=/usr/bin/python3 /usr/local/lib/joanpi/joanpi_deploy.py check
ExecStopPost=+/usr/bin/python3 /usr/local/lib/joanpi/job_status.py joanpi-deploy
TimeoutStartSec=1h
Nice=10
