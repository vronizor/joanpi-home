[Unit]
Description=JoanPi home: pull homepage and Pi Projects changes from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@OWNER@
WorkingDirectory=@HOME@/joanpi-home
ExecStart=/usr/bin/git pull --ff-only --quiet
ExecStopPost=+/usr/bin/python3 /usr/local/lib/joanpi/job_status.py joanpi-home-pull
TimeoutStartSec=5min
